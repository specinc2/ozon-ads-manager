{
  "manifest_version": 3,
  "name": "Ozon Price Helper",
  "version": "1.0.0",
  "description": "Собирает цены и страну поставки (РФ/Китай) с карточек Ozon для анализатора цен",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://*.dungeonverse.ru/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8002/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/product/*", "https://ozon.ru/product/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ozon Price Helper"
  }
}
