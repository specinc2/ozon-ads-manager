# Секретный ключ для сессий и шифрования (сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=change-me-to-a-random-secret-key
ENCRYPTION_KEY=change-me-to-a-fernet-key

# Режим отладки
DEBUG=true

# База данных (sqlite для dev, postgresql+asyncpg://user:pass@host/db для прода)
DATABASE_URL=sqlite+aiosqlite:///./data/ozon_ads.db

# Максимальное количество кампаний для синхронизации
MAX_CAMPAIGNS=100

# Интервал планировщика в минутах (не менее 5)
SCHEDULER_INTERVAL_MINUTES=5