# Секретный ключ для сессий и шифрования (сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=change-me-to-a-random-secret-key
ENCRYPTION_KEY=change-me-to-a-fernet-key

# Режим отладки
DEBUG=true

# База данных (sqlite для dev, postgresql+asyncpg://user:pass@host/db для прода)
DATABASE_URL=sqlite+aiosqlite:///./data/ozon_ads.db

# Максимальное количество кампаний для синхронизации
MAX_CAMPAIGNS=100

# Интервал планировщика в минутах (не менее 5)
SCHEDULER_INTERVAL_MINUTES=8

# Прокси для обхода антибота маркетплейсов: http://user:pass@host:port
# PROXY_URL=

# ScraperAPI — 1000 запросов/мес бесплатно, без карты: https://scraperapi.com
# Не работает для Ozon без premium-плана.
# SCRAPERAPI_API_KEY=

# ScrapingAnt — 10 000 запросов/мес бесплатно: https://scrapingant.com
# Ozon блокирует их браузеры (423 Locked) — не работает для Ozon.
# SCRAPINGANT_API_KEY=

# Bright Data — официальный API цен Ozon по URL товара.
# Настраивается в интерфейсе: Настройки → Bright Data (API-ключ + Dataset ID).
# Нужен активный счёт, иначе ошибка "Customer is not active".
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_DATASET_ID=gd_lutq85sl13rlndbzai
